# --- BRANDING CONFIGURATION ---
# The branding title name shown on login, loading, and navigation headers
PANEL_NAME=

# --- SERVER CONNECTION INFO ---
# The IP address/domain and port of the Minecraft Server displayed in the UI
MINECRAFT_SERVER_ADDR=
# The version of the Minecraft Server displayed in the UI (e.g. 26.1.2)
MINECRAFT_VERSION=

# --- MINECRAFT SERVER PROCESS CONFIGURATION ---
# The path to the Minecraft Server directory (containing server.properties, paper.jar, logs, etc.)
MINECRAFT_SERVER_DIR=

# The server executable runtime file name (e.g., paper.jar, spigot.jar, server.jar)
MINECRAFT_JAR_NAME=

# JVM Java heap space memory allocations
MINECRAFT_MIN_RAM=
MINECRAFT_MAX_RAM=

# --- SECURITY & UTILITIES ---
# Secret key used for JWT session encryption signing. Change to a long random hash in production.
SECRET_KEY=

# Database connection URL (SQLAlchemy async SQLite engine string)
DATABASE_URL=

# --- AGENT SPLIT HOSTING CONFIGURATION ---
# Shared secret token to authenticate the local PC agent with the cloud backend.
# If set, the backend operates in remote/agent proxy mode.
AGENT_TOKEN=
